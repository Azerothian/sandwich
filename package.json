{
  "name": "@azerothian/sandwich",
  "version": "1.1.0",
  "main": "cjs/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "type": "module",
  "scripts": {
    "package:yalc": "pnpm run build; cd publish; yalc publish",
    "yalc:update": "yalc update; pnpm install",
    "build": "rm -Rf ./publish || true; mkdir ./publish && run-s build:*",
    "build:readme": "cp ./README.md ./publish/README.md",
    "build:src": "copyfiles -u 1 \"src/**/*\" publish/src",
    "build:package": "yalc retreat --all; tsx ./scripts/prepare-package.ts; yalc restore --all; pnpm install",
    "build:main": "swc src --out-dir publish/lib --strip-leading-paths -s",
    "build:types": "tsc -p tsconfig.types.json --outDir publish/types",
    "build:copy-dts": "copyfiles -u 1 \"src/**/*.d.ts\" publish/lib",
    "build:cjs": "swc src --out-dir publish/cjs --config-file=.swcrc-cjs --strip-leading-paths -s"
  },
  "files": [
    "**/*"
  ],
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.11.21",
    "@swc/jest": "^0.2.37",
    "@types/debug": "^4.1.12",
    "@types/node": "^20.17.30",
    "copyfiles": "^2.4.1",
    "globby": "^14.1.0",
    "jest": "^29.7.0",
    "npm-run-all2": "^6.2.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "debug": "^4.4.0",
    "deepmerge": "^4.3.1",
    "is-plain-object": "^5.0.0",
    "uuid": "^9.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}